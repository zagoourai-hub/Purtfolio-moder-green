// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hashed
  createdAt DateTime @default(now())
}

model HeroSection {
  id          String   @id @default(cuid())
  greeting    String   // "Hi, I'm"
  name        String
  tagline     String
  description String   @db.Text
  ctaLabel    String
  ctaUrl      String
  avatarUrl   String?
  updatedAt   DateTime @updatedAt
}

model AboutSection {
  id          String   @id @default(cuid())
  bio         String   @db.Text  // Markdown
  photoUrl    String?
  location    String?
  email       String?
  resumeUrl   String?
  updatedAt   DateTime @updatedAt
}

model Skill {
  id       String  @id @default(cuid())
  name     String
  category String  // "Frontend", "Backend", "DevOps", etc.
  iconUrl  String?
  level    Int     @default(0)  // 0-100
  order    Int     @default(0)
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text  // Markdown
  coverUrl    String?
  techStack   String[] // array of tech names
  liveUrl     String?
  repoUrl     String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String    @db.Text
  content     String    @db.Text  // Markdown / MDX
  coverUrl    String?
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String  @db.Text
  iconUrl     String?
  price       String? // "From $500" — opsional
  order       Int     @default(0)
  published   Boolean @default(false)
}

model Testimonial {
  id         String  @id @default(cuid())
  clientName String
  clientRole String?
  company    String?
  avatarUrl  String?
  content    String  @db.Text
  rating     Int     @default(5)  // 1-5
  featured   Boolean @default(false)
  published  Boolean @default(false)
  order      Int     @default(0)
}

model ContactLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text
}
